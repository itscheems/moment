#!/usr/bin/env bash
set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [[ "$branch" == "main" && "${ALLOW_MAIN_COMMIT:-}" != "1" ]]; then
  echo "BLOCKED: commits on main require explicit human authorization for the current task." >&2
  echo "If authorized, run this commit with ALLOW_MAIN_COMMIT=1; other checks still apply." >&2
  exit 1
fi

if ! git diff --cached --check; then
  echo "BLOCKED: staged changes contain whitespace errors or conflict markers." >&2
  exit 1
fi

staged_paths="$(git diff --cached --name-only --diff-filter=ACMR)"
if printf '%s\n' "$staged_paths" | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$' >/dev/null; then
  echo "BLOCKED: a local environment or secret file is staged." >&2
  exit 1
fi

if printf '%s\n' "$staged_paths" | grep -E '(^|/)(node_modules|dist|data|moment-data|\.worktrees)(/|$)' >/dev/null; then
  echo "BLOCKED: generated, runtime, or worktree content is staged." >&2
  exit 1
fi
