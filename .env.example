# Local runtime state belongs outside the source tree.
MOMENT_DATA_DIR=./moment-data
MOMENT_LISTEN=127.0.0.1:8080
MOMENT_OWNER_TOKEN_FILE=./.moment-local/owner.token

# Optional place suggestions for post location. Keep provider keys server-side;
# the Web client never receives them. Manual location labels work without keys.
AMAP_API_KEY=
GEOAPIFY_API_KEY=

# Federated sign-in. Both halves of a pair are required; a provider missing
# either is simply not offered on the sign-in page. Register the callback with
# the provider exactly as it will be requested — a redirect URI is matched
# character for character, so http://127.0.0.1:8080/... and
# http://localhost:8080/... are two different registrations.
#
#   {public_base_url or http://127.0.0.1:<port> in development}
#     /api/v1/login/oauth/{google|github}/callback
#
# The fallback only applies to a loopback bind. A deployment that listens on a
# public address -- which the shipped Dockerfile does -- has no address to
# guess, so sign-in stays unavailable until public_base_url is set in Settings,
# and the server says so at startup rather than answering an empty provider
# list. Setting it takes effect on the next start.
MOMENT_GOOGLE_CLIENT_ID=
MOMENT_GOOGLE_CLIENT_SECRET=

# The Google client registered for the iOS app, if there is one.
#
# A separate client because Google issues one per platform and a mobile app is a
# public client: it holds no secret, runs the authorization itself, and finishes
# holding an ID token naming this id as its audience. That token is what it
# sends to POST /api/v1/login/oauth/google/assertion, and this is the only
# audience that route accepts -- the web client id above is deliberately not
# interchangeable with it.
#
# Leave it empty and Google simply does not advertise the assertion flow, so the
# app draws no Google button. There is no secret to set: an iOS client has none.
MOMENT_GOOGLE_IOS_CLIENT_ID=
MOMENT_GITHUB_CLIENT_ID=
MOMENT_GITHUB_CLIENT_SECRET=

# `moment login github` signs a terminal in with no browser redirect, using the
# same GitHub client above. GitHub refuses that flow unless "Enable Device Flow"
# is ticked on the OAuth App itself, and reports device_flow_disabled when it is
# not. Google is not offered this way: its device flow needs a separately
# registered "TVs and Limited Input devices" client, which is not the one a
# redirect URI belongs to.
